# eSIMprove — environment variable template
#
# Copy to `.env.local` for local development, or run `npm run db:setup`, which
# generates a local-only `.env.local` with random demo secrets.
#
# Netlify: set values in Site configuration → Environment variables, scoped to
# the correct deploy context. A deploy preview must use a preview database and
# preview secrets, never the production values. Never commit a filled copy.
# Do not put a Netlify deploy token in this file.
#
# Rules:
# - Empty means "not configured". Do not invent credentials.
# - Live integrations default to false. Enabling one requires the launch gates
#   in docs/LAUNCH-GATES.md and explicit owner authorisation.
# - Production fails closed if required values are missing or demo mode is on.
# - The values below are placeholders or safe local defaults, not credentials.
#
# Netlify deploy contexts (APP_ENV and DATABASE_ENV must match):
#   deploy preview  -> preview
#   branch/staging  -> staging
#   production      -> production
# NETLIFY=true is a platform signal, not a production decision.

# ---------------------------------------------------------------------------
# Site identity — SITE_URL is the only public-origin setting.
# ---------------------------------------------------------------------------
# Local: http://localhost:3000
# Deployed: the verified HTTPS origin for that context (Netlify URL, branch
# deploy URL, or custom domain). No trailing slash.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=eSIMprove
# Reserved branding values; not read by the current build.
DEFAULT_LOCALE=en
DEFAULT_CURRENCY=USD

# ---------------------------------------------------------------------------
# Deployment context and demo mode
# ---------------------------------------------------------------------------
# local | test | preview | staging | production
# Required explicitly on Netlify. Preview/staging must stay demo/noindex.
APP_ENV=local
# Production must be false. Preview must be true. Mock commerce is disabled in
# production regardless of this value.
DEMO_MODE=true
# Production must be false. Preview/staging may seed their isolated database.
SEED_DEMO_DATA=true

# Legal entity details are unknown. Leave empty; do not invent a company.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_REGISTRATION_NUMBER=
LEGAL_ENTITY_COUNTRY=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_VAT_ID=
SUPPORT_EMAIL=
SECURITY_EMAIL=
ABUSE_EMAIL=

# ---------------------------------------------------------------------------
# Database — PostgreSQL in deployed contexts; PGlite only for local/test
# ---------------------------------------------------------------------------
# DATABASE_ENV must equal APP_ENV in preview, staging, and production. This
# prevents a preview deploy from silently using the production connection.
DATABASE_ENV=local
# Required for preview, staging, and production. Use a context-scoped value.
# Prefer a pooled connection string from the provider for serverless use.
DATABASE_URL=
# Optional direct/session connection used only by db:migrate and db:seed.
# Keep the app on the pooled URL; use this for advisory-locked migrations.
DATABASE_MIGRATION_URL=
# require (verify certificate) | verify-ca | verify-full | disable
# Deployed values must not be disable. Defaults to require in deployed contexts.
DATABASE_SSL=require
# Optional PEM CA bundle for a provider that does not use a public CA. Literal
# newlines or \n escapes are accepted. Never commit a private key.
DATABASE_SSL_CA=
# Keep small: each serverless instance has its own pool. 1–10.
DATABASE_POOL_MAX=3
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Local embedded database only. Deployed contexts refuse to start on PGlite.
PGLITE_DATA_DIR=.pglite

# ---------------------------------------------------------------------------
# Authentication (database sessions)
# ---------------------------------------------------------------------------
# At least 32 random characters. Required in every deployed context.
AUTH_SECRET=
SESSION_COOKIE_PREFIX=esimprove
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_MINUTES=60
# Must be true in deployed contexts.
ADMIN_2FA_REQUIRED=true

# Demo administrator, seeded only when SEED_DEMO_DATA=true and APP_ENV is not
# production. `npm run db:setup` generates these into `.env.local`.
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_TOTP_SECRET=

# One-off production admin bootstrap (`npm run admin:create`). These are read
# only by the script, never by the running app. Do not store them in Netlify's
# Functions scope. ADMIN_CREATE_CONFIRM must be CREATE when APP_ENV=production.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
ADMIN_CREATE_CONFIRM=

# ---------------------------------------------------------------------------
# Activation-data encryption (envelope encryption)
# ---------------------------------------------------------------------------
# 32-byte base64 key. Required in every deployed context. Versioned; keep old
# versions available for decryption during rotation. Never reuse across contexts.
ACTIVATION_KEK_V1=
ACTIVATION_KEK_ACTIVE_VERSION=1

# Dedicated 32-byte base64 key for supplier credentials. Required in production.
# Local demo may explicitly opt into the activation KEK fallback.
SUPPLIER_CREDENTIAL_KEK=
SUPPLIER_CREDENTIAL_ALLOW_ACTIVATION_KEK_FALLBACK=false

# ---------------------------------------------------------------------------
# Internal jobs and scheduling
# ---------------------------------------------------------------------------
# Required in deployed contexts. Protects POST /api/jobs/run. There is no
# scheduler configured in this build; see the deployment guide.
INTERNAL_JOB_SECRET=
# Reserved; not read by the current build.
CRON_SECRET=
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=8
JOB_BACKOFF_BASE_SECONDS=30

# ---------------------------------------------------------------------------
# Feature flags and kill switches (safe defaults)
# ---------------------------------------------------------------------------
# All live flags must remain false in every deployed context for this build.
PAYMENTS_LIVE_ENABLED=false
SUPPLIER_LIVE_ENABLED=false
EMAIL_LIVE_ENABLED=false
CATALOGUE_SYNC_ENABLED=false
# Legacy/reserved flag; must remain false. First-party analytics is controlled
# by consent and NEXT_PUBLIC_ANALYTICS_DISABLED, not this flag.
ANALYTICS_ENABLED=false
STAGING_ACCESS_ENABLED=false
MAINTENANCE_BANNER_ENABLED=false

# ---------------------------------------------------------------------------
# Supplier (provider-neutral; eSIM Access proposed, disabled)
# ---------------------------------------------------------------------------
# Reserved integration configuration. No live supplier transport exists yet;
# N-07 remains open until outbound destination validation, address binding,
# redirect restrictions, timeouts, response-size limits, and safe logging exist.
SUPPLIER_DEFAULT=esim_access
ESIM_ACCESS_BASE_URL=
ESIM_ACCESS_CODE=
ESIM_ACCESS_SECRET=
ESIM_ACCESS_WEBHOOK_PATH_TOKEN=
ESIM_ACCESS_WEBHOOK_IP_ALLOWLIST=
ESIM_ACCESS_PRICE_SCALE=
SUPPLIER_BALANCE_RESERVE_MINOR=
ESIM_GO_BASE_URL=
ESIM_GO_API_KEY=
ESIM_GO_WEBHOOK_SECRET=

# Mock supplier behaviour (local/test/preview only; never production).
MOCK_SUPPLIER_FAIL_ONCE=false

# ---------------------------------------------------------------------------
# Payments (mock only in local/test/preview; disabled in production)
# ---------------------------------------------------------------------------
# Server-side provider selector. Leave empty for the current deployment: an
# empty value selects the mock adapter outside production, while production
# checkout remains disabled. Do not set `whop` until the catalogue mapping,
# webhook secret, public APP_URL, and explicit approval exist. Setting `whop`
# does not enable live payments by itself.
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=USD
# Required for mock commerce in local/test/preview. Not used in production.
MOCK_PAYMENT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_API_VERSION=
STRIPE_LIVE_MODE=false
# Whop variables are defined once, in the "Whop hosted checkout" section below.
# Do not add duplicates here: the last assignment in a dotenv file wins.

# ---------------------------------------------------------------------------
# Crypto payments — Binance-Peg USDT (BEP-20) on BNB Smart Chain
# ---------------------------------------------------------------------------
# Server-only. Never create NEXT_PUBLIC_ versions of these values, and never
# place a private key, seed phrase, or wallet credential in this application.
#
# Crypto checkout is disabled unless every required value below is present and
# valid. A partial configuration fails closed and the checkout shows the crypto
# method as unavailable. No funds are accepted and no order can be created for
# crypto until the configuration passes validation.
#
# PAYMENT_WALLET          - the documented public receiving wallet:
#                           0xBF93e7123FfEf0973d469F6Ce39D201dC2e5Aa5E
#                           Any other valid address is rejected.
# BNB_RPC_URL             - NodeReal MegaNode BSC Mainnet HTTPS endpoint from
#                           https://dashboard.nodereal.io/api-key, e.g.
#                           https://bsc-mainnet.nodereal.io/v1/<YOUR_API_KEY>
#                           The URL contains the API key: keep it server-only,
#                           never NEXT_PUBLIC_. It is used both to discover
#                           incoming USDT Transfer logs (eth_getLogs) and to
#                           verify chain ID, receipt, recipient, exact raw
#                           amount, block timestamp, and confirmations.
# PAYMENT_TOKEN_CONTRACT  - must be the documented Binance-Peg BSC-USD token:
#                           0x55d398326f99059fF775485246999027B3197955
# PAYMENT_CHAIN_ID        - must be 56 (BNB Smart Chain)
#
# The payment worker must be scheduled against POST /api/jobs/run with the
# INTERNAL_JOB_SECRET (or CRON_SECRET) header. Browser polling is not a
# substitute for the server-side worker.
PAYMENT_WALLET=
BNB_RPC_URL=
PAYMENT_TOKEN_CONTRACT=
PAYMENT_CHAIN_ID=

# ---------------------------------------------------------------------------
# Transactional email (local logger outside production; disabled in production)
# ---------------------------------------------------------------------------
# Reserved provider metadata; only the mock transport is selectable in this
# build, and production uses a fail-closed disabled transport.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_WEBHOOK_SECRET=
EMAIL_TEST_RECIPIENT=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Optional. When set, send x-health-token or Authorization: Bearer <token> to
# /api/health for non-secret diagnostics. Public callers see status only.
HEALTH_CHECK_TOKEN=
# Reserved; not read by the current build.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Staging protection (reserved; not implemented in the current build)
# ---------------------------------------------------------------------------
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD_HASH=
STAGING_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Rate limiting and privacy-preserving identifiers
# ---------------------------------------------------------------------------
# HMAC key for hashing IPs/emails in logs and rate-limit counters. Required in
# every deployed context.
RATE_LIMIT_HASH_SECRET=

# ---------------------------------------------------------------------------
# First-party analytics (anonymous, consent-based)
# ---------------------------------------------------------------------------
# Dedicated HMAC key for analytics visitor/session hashes and consent-subject
# hashes. Required in preview, staging, and production; at least 32 random
# characters and distinct from AUTH_SECRET and RATE_LIMIT_HASH_SECRET. Local
# demo/test may omit it and use a non-secret local fallback.
ANALYTICS_HASH_SECRET=
# Analytics retention is stored in data_retention_settings and managed in
# Admin -> Legal & compliance. Proposed technical defaults (not owner-approved)
# are 395 days for raw events and 730 days for aggregated sessions/visitors.
# The owner must confirm or change them before cleanup is enabled in production.
# No environment variable overrides the database policy. Consent validity
# (180 days) is a separate policy.
# Optional kill switch. true makes /api/track return 204 before storage. The
# client may still attempt a request, which stores nothing.
NEXT_PUBLIC_ANALYTICS_DISABLED=false
# Google Search Console verification and optional GA4 IDs are stored in the
# database (Admin -> SEO & CMS), not in environment variables.

# ---------------------------------------------------------------------------
# Content Security Policy media allowlists (optional)
# ---------------------------------------------------------------------------
# Comma-separated exact HTTPS origins for externally hosted images and
# audio/video. Empty means only first-party, data:, and blob: sources are
# allowed. Add a host here before using an external blog image URL; wildcards
# are rejected.
CSP_IMAGE_HOSTS=
CSP_MEDIA_HOSTS=

# ---------------------------------------------------------------------------
# Whop hosted checkout (official @whop/sdk integration)
# ---------------------------------------------------------------------------
# Required when PAYMENT_PROVIDER=whop:
#   WHOP_COMPANY_API_KEY       - Whop Account API key for the business account
#                                that owns the products/variants (server secret,
#                                never expose). It must be allowed to create
#                                checkout configurations and read products and
#                                variants. Payment confirmation arrives through
#                                the signed webhook, not a payments API read.
#                                Whop has no separate "checkout API key";
#                                sandbox and production keys are different
#                                credentials.
#   WHOP_WEBHOOK_SECRET        - Whop webhook signing secret (server secret, never expose)
#   WHOP_SANDBOX               - explicit "true" or "false" (no default)
#   APP_URL                    - public HTTPS origin for hosted checkout redirect URLs
#   WHOP_PLAN_VARIANT_MAP      - at least one verified ESIMPROVE -> variant mapping
#
# Optional at runtime; required by `scripts/whop-discover.ts`. Supplying the
# biz_... account ID avoids account-listing calls that need broader scopes.
# The configured credential is an Account API key scoped to that business.
WHOP_ACCOUNT_ID=
#
# Missing or incomplete values fail closed: checkout is unavailable and the
# webhook returns 503 until configured. No live activation is automatic.
WHOP_COMPANY_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_SANDBOX=
APP_URL=

# Whop plan mapping: ESIMPROVE plan slug or plan ID -> Whop variant ID ("plan_...").
# Whop checkout currently supports one plan per order at quantity 1 with no tax.
# The variant's currency and initial price must match the ESIMPROVE plan exactly.
# Run `npx tsx scripts/whop-discover.ts` after setting the key to list variants.
# The current account has no products or variants, so this must stay empty until
# real Whop products exist and an exact match is verified. Never invent a mapping.
# Example: { "japan-1000mb-7d": "plan_abc123" }
WHOP_PLAN_VARIANT_MAP={}

# ---------------------------------------------------------------------------
# Tax (disabled until reviewed; do not invent rates)
# ---------------------------------------------------------------------------
TAX_MODE=disabled
TAX_RATE_TABLE_VERSION=
