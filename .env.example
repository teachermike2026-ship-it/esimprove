# eSIMprove — environment template
#
# Copy to `.env.local` for local development, or run `npm run db:setup`,
# which generates a local-only `.env.local` with random demo secrets.
# Never commit a filled copy. In Netlify, set values in Site configuration →
# Environment variables and mark secrets as secret. Do not put a Netlify deploy
# token in this file.
#
# Rules:
# - Empty means "not configured". Do not invent credentials.
# - Live integrations default to false. Enabling one requires the launch gates
#   in docs/LAUNCH-GATES.md and explicit owner authorisation.
# - Production must fail closed if a live flag is true but its required values
#   or legal configuration are missing.
# - Values below are placeholders or safe local defaults, not real credentials.

# ---------------------------------------------------------------------------
# Site identity — the only place the public origin is configured.
# Change this when the domain is purchased and verified. Default is local.
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=eSIMprove
DEFAULT_LOCALE=en
DEFAULT_CURRENCY=USD

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Do not set NODE_ENV in a deployed environment; let Next.js manage it.
APP_ENV=local
# local | staging | production
DEMO_MODE=true
SEED_DEMO_DATA=true

# Legal entity details are unknown. Leave empty; do not invent a company.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_REGISTRATION_NUMBER=
LEGAL_ENTITY_COUNTRY=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_VAT_ID=
SUPPORT_EMAIL=
SECURITY_EMAIL=
ABUSE_EMAIL=

# ---------------------------------------------------------------------------
# Database (PostgreSQL in production; PGlite locally)
# ---------------------------------------------------------------------------
# If empty and APP_ENV is not production, PGlite is used.
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_SSL=require
PGLITE_DATA_DIR=.pglite

# ---------------------------------------------------------------------------
# Authentication (database sessions; local demo implementation)
# ---------------------------------------------------------------------------
# At least 32 random bytes. Generated by `npm run db:setup` for local use.
AUTH_SECRET=
SESSION_COOKIE_PREFIX=esimprove
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_MINUTES=60
ADMIN_2FA_REQUIRED=true

# Demo administrator, seeded only when SEED_DEMO_DATA=true and not production.
# `npm run db:setup` generates a random password and TOTP secret in `.env.local`.
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_TOTP_SECRET=

# ---------------------------------------------------------------------------
# Activation-data encryption (envelope encryption)
# ---------------------------------------------------------------------------
# 32-byte base64 key. Versioned; keep old versions available for decryption
# during rotation. Never reuse a key across environments.
ACTIVATION_KEK_V1=
ACTIVATION_KEK_ACTIVE_VERSION=1

# ---------------------------------------------------------------------------
# Internal jobs and scheduling
# ---------------------------------------------------------------------------
INTERNAL_JOB_SECRET=
CRON_SECRET=
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=8
JOB_BACKOFF_BASE_SECONDS=30

# ---------------------------------------------------------------------------
# Feature flags and kill switches (safe defaults)
# ---------------------------------------------------------------------------
PAYMENTS_LIVE_ENABLED=false
SUPPLIER_LIVE_ENABLED=false
EMAIL_LIVE_ENABLED=false
CATALOGUE_SYNC_ENABLED=false
ANALYTICS_ENABLED=false
STAGING_ACCESS_ENABLED=false
MAINTENANCE_BANNER_ENABLED=false

# ---------------------------------------------------------------------------
# Supplier (provider-neutral; eSIM Access proposed, disabled)
# ---------------------------------------------------------------------------
SUPPLIER_DEFAULT=esim_access
ESIM_ACCESS_BASE_URL=
ESIM_ACCESS_CODE=
ESIM_ACCESS_SECRET=
# Random path segment for the supplier webhook; not a substitute for a signature.
ESIM_ACCESS_WEBHOOK_PATH_TOKEN=
# Optional comma-separated allowlist; confirm stable egress IPs with the supplier.
ESIM_ACCESS_WEBHOOK_IP_ALLOWLIST=
# Supplier price scale must be confirmed in the account. Do not assume cents.
ESIM_ACCESS_PRICE_SCALE=
# Minimum supplier balance in minor units before new live orders are blocked.
SUPPLIER_BALANCE_RESERVE_MINOR=

# Fallback adapter (disabled; $1,000 minimum top-up documented, not approved)
ESIM_GO_BASE_URL=
ESIM_GO_API_KEY=
ESIM_GO_WEBHOOK_SECRET=

# Mock supplier behaviour (local demo only; never live)
MOCK_SUPPLIER_FAIL_ONCE=false

# ---------------------------------------------------------------------------
# Payments (provider-neutral; mock sandbox by default, Stripe disabled)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=USD
MOCK_PAYMENT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Pin an API version after testing; do not silently follow account defaults.
STRIPE_API_VERSION=
STRIPE_LIVE_MODE=false
# Public-origin URLs use SITE_URL only. Do not add a second origin setting.

# ---------------------------------------------------------------------------
# Transactional email (provider-neutral; local logger, Resend disabled)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=mock
RESEND_API_KEY=
# Leave empty until the sending domain is verified.
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_WEBHOOK_SECRET=
EMAIL_TEST_RECIPIENT=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=info
# Protects a minimal health endpoint if one is exposed publicly.
HEALTH_CHECK_TOKEN=

# ---------------------------------------------------------------------------
# Staging protection (free-plan substitute, not enterprise SSO)
# ---------------------------------------------------------------------------
STAGING_BASIC_AUTH_USER=
# Store a bcrypt/argon2 hash, not the plaintext password.
STAGING_BASIC_AUTH_PASSWORD_HASH=
STAGING_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Rate limiting and privacy-preserving identifiers
# ---------------------------------------------------------------------------
# HMAC key for hashing IPs/emails in logs and rate-limit counters.
RATE_LIMIT_HASH_SECRET=

# ---------------------------------------------------------------------------
# Tax (disabled until reviewed; do not invent rates)
# ---------------------------------------------------------------------------
TAX_MODE=disabled
TAX_RATE_TABLE_VERSION=
