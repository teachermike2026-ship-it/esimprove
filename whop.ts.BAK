/**
 * Whop payment adapter — structure implemented per current official documentation.
 * Status: BLOCKED — no Whop company API key, webhook secret, or account approval configured.
 * Sandbox verification cannot occur without credentials.
 * Production activation disabled until eligibility and authorization confirmed.
 */

export interface WhopCheckoutInput {
  orderId: string;
  amountMinor: number;
  currency: string;
  productName: string;
  customerEmail: string;
}

export interface WhopCheckoutResponse {
  checkoutUrl: string;
  checkoutId: string;
  status: "pending" | "paid" | "failed" | "cancelled";
}

export interface WhopWebhookPayload {
  event: string;
  checkout_id: string;
  status: string;
  amount?: number;
  currency?: string;
  metadata?: { orderId?: string };
}

export interface WhopAdapterConfig {
  companyApiKey: string | null;
  webhookSecret: string | null;
  sandbox: boolean;
  appUrl: string;
}

function getConfig(): WhopAdapterConfig {
  return {
    companyApiKey: process.env.WHOP_COMPANY_API_KEY ?? null,
    webhookSecret: process.env.WHOP_WEBHOOK_SECRET ?? null,
    sandbox: process.env.WHOP_SANDBOX === "true" || process.env.APP_ENV === "development",
    appUrl: process.env.APP_URL ?? process.env.SITE_URL ?? "http://localhost:3000",
  };
}

export function isWhopConfigured(): boolean {
  return !!getConfig().companyApiKey;
}

export function validateWebhookSignature(payload: string, signatureHeader: string, secret: string): boolean {
  // Placeholder: official Whop webhook verification requires current documented method.
  // Not implemented with real secret because secrets are not configured.
  if (!secret) return false;
  // Production verification must use official Whop documentation and actual secret.
  return true; // Only returns true for structural demonstration; requires real secret for production.
}

export async function createWhopCheckout(input: WhopCheckoutInput): Promise<WhopCheckoutResponse> {
  const cfg = getConfig();
  if (!cfg.companyApiKey) {
    throw new Error("Whop checkout blocked: WHOP_COMPANY_API_KEY not configured.");
  }
  // Real implementation must call official Whop checkout endpoint with validated credentials.
  // Blocked: no credentials, no sandbox verification performed.
  throw new Error("Whop checkout blocked: account eligibility/credentials not verified.");
}

export async function verifyWhopPayment(checkoutId: string): Promise<{ status: string; orderId?: string }> {
  const cfg = getConfig();
  if (!cfg.companyApiKey) {
    throw new Error("Whop verification blocked: WHOP_COMPANY_API_KEY not configured.");
  }
  // Real verification requires official Whop API with configured key.
  throw new Error("Whop verification blocked: no credentials or sandbox test performed.");
}
